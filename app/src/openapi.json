{
  "openapi": "3.0.3",
  "info": {
    "title": "Tasks API",
    "version": "3.3"
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/": {
      "get": {
        "summary": "Назва і версія API",
        "responses": {
          "200": {
            "description": "Назва і версія",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "example": "Tasks API" },
                    "version": { "type": "string", "example": "1.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Стан застосунку і БД",
        "responses": {
          "200": {
            "description": "Застосунок і БД працюють",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          },
          "503": {
            "description": "БД недоступна",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "error" } }
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Отримати JWT-токен",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Токен (дійсний 1 годину)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "token": { "type": "string" } }
                }
              }
            }
          },
          "401": {
            "description": "Неправильний логін або пароль",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "Останні 50 задач, новіші першими",
        "responses": {
          "200": {
            "description": "Масив задач (не більше 50)",
            "headers": {
              "X-Cache": { "$ref": "#/components/headers/X-Cache" },
              "X-Cache-Coalesced": { "$ref": "#/components/headers/X-Cache-Coalesced" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Створити задачу",
        "description": "З заголовком Idempotency-Key перша відповідь (статус і тіло) зберігається в Redis на 24 години, повтор з тим самим ключем повертає її без нової вставки. Без заголовка поведінка звичайна.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewTask" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Задачу створено (або повтор збереженої відповіді для того самого Idempotency-Key)",
            "headers": {
              "Idempotency-Replayed": { "$ref": "#/components/headers/Idempotency-Replayed" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": {
            "description": "Не передано title або некоректний Idempotency-Key",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Немає або недійсний токен",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/IdempotencyInProgress" },
          "422": { "$ref": "#/components/responses/IdempotencyMismatch" },
          "503": { "$ref": "#/components/responses/IdempotencyUnavailable" }
        }
      }
    },
    "/tasks/async": {
      "post": {
        "summary": "Створити задачу асинхронно через чергу SQS",
        "description": "Сервіс кладе повідомлення в чергу і одразу відповідає 202 з id операції. Задачу вставляє окремий обробник; результат - у GET /jobs/{id} (Location). Idempotency-Key працює так само, як у POST /tasks: повтор поверне ту саму операцію.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewTask" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Операцію прийнято в чергу",
            "headers": {
              "Location": {
                "description": "Адреса статусу операції",
                "schema": { "type": "string", "example": "/jobs/1d93a2b9-a754-4ce9-a049-023dc0c41ade" }
              },
              "Idempotency-Replayed": { "$ref": "#/components/headers/Idempotency-Replayed" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Accepted" }
              }
            }
          },
          "400": {
            "description": "Не передано title або некоректний Idempotency-Key",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Немає або недійсний токен",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/IdempotencyInProgress" },
          "422": { "$ref": "#/components/responses/IdempotencyMismatch" },
          "503": {
            "description": "Черга не налаштована або недоступна, Redis недоступний; операцію не прийнято",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/jobs/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "summary": "Статус асинхронної операції",
        "description": "queued - повідомлення в черзі або обробляється, done - задачу створено (taskId), failed - усі спроби обробки невдалі, повідомлення пішло в dead-letter queue. Статус зберігається в Redis 24 години.",
        "responses": {
          "200": {
            "description": "Статус операції",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Job" }
              }
            }
          },
          "400": {
            "description": "Некоректний id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Операції немає або минуло 24 години",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "503": {
            "description": "Redis недоступний",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "minimum": 1 }
        }
      ],
      "get": {
        "summary": "Одна задача",
        "responses": {
          "200": {
            "description": "Задача",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": {
            "description": "Некоректний id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Задачу не знайдено",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Видалити задачу",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": {
            "description": "Задачу видалено"
          },
          "400": {
            "description": "Некоректний id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Немає або недійсний токен",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Задачу не знайдено",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/authors/{username}": {
      "parameters": [
        {
          "name": "username",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "example": "admin" }
        }
      ],
      "get": {
        "summary": "Дані автора: кількість задач і час останньої",
        "description": "Відповідь кешується в Redis на AUTHOR_CACHE_TTL_SECONDS (за замовчуванням 5 с) без інвалідації на POST і DELETE, тому дані можуть відставати на кілька секунд.",
        "responses": {
          "200": {
            "description": "Дані автора (для автора без задач taskCount = 0, lastTaskAt = null)",
            "headers": {
              "X-Cache": { "$ref": "#/components/headers/X-Cache" },
              "X-Cache-Coalesced": { "$ref": "#/components/headers/X-Cache-Coalesced" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Author" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "X-Cache": {
        "description": "HIT - відповідь з Redis, MISS - з бази і записано в кеш, BYPASS - кеш вимкнено або Redis недоступний",
        "schema": { "type": "string", "enum": ["HIT", "MISS", "BYPASS"] }
      },
      "X-Cache-Coalesced": {
        "description": "Є лише тоді, коли запит не ходив у базу сам, а дочекався результату такого самого запиту, який уже виконувався в цьому процесі (single-flight)",
        "schema": { "type": "string", "enum": ["true"] }
      },
      "Idempotency-Replayed": {
        "description": "Є лише в запитах з Idempotency-Key: false - запит виконано зараз, true - повернуто збережену відповідь",
        "schema": { "type": "string", "enum": ["true", "false"] }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Унікальний ключ операції від клієнта, 1-255 видимих ASCII-символів. Ключі окремі для кожного користувача.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 255, "example": "3f6c2a9e-1b7d-4c55-9a0e-6f2d8b1c7e44" }
      }
    },
    "responses": {
      "IdempotencyInProgress": {
        "description": "Запит з цим Idempotency-Key ще виконується (результат не з'явився за 2 с)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "IdempotencyMismatch": {
        "description": "Idempotency-Key уже використано з іншим тілом запиту",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "IdempotencyUnavailable": {
        "description": "Передано Idempotency-Key, але Redis недоступний; запит не виконано",
        "headers": {
          "Retry-After": { "schema": { "type": "integer", "example": 1 } }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "password": { "type": "string" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Купити молоко" },
          "done": { "type": "boolean", "example": false },
          "created_at": { "type": "string", "format": "date-time" },
          "author": { "type": "string", "nullable": true, "example": "admin" }
        }
      },
      "NewTask": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "example": "Купити молоко" }
        }
      },
      "Author": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "taskCount": { "type": "integer", "example": 12 },
          "lastTaskAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Task not found" }
        }
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "jobId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["queued"] },
          "location": { "type": "string", "example": "/jobs/1d93a2b9-a754-4ce9-a049-023dc0c41ade" }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["queued", "done", "failed"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "taskId": { "type": "integer", "description": "Є, коли status = done", "example": 11 },
          "task": { "type": "string", "description": "Є, коли status = done", "example": "/tasks/11" },
          "attempts": { "type": "integer", "description": "Номер спроби доставки, на якій операцію завершено", "example": 1 },
          "duplicate": { "type": "boolean", "description": "true, якщо це повторна доставка вже обробленого повідомлення" },
          "error": { "type": "string", "description": "Є, коли status = failed" }
        }
      }
    }
  }
}
