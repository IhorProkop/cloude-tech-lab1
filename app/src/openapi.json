{
  "openapi": "3.0.3",
  "info": {
    "title": "Tasks API",
    "version": "3.0"
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/": {
      "get": {
        "summary": "Назва і версія API",
        "responses": {
          "200": {
            "description": "Назва і версія",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "example": "Tasks API" },
                    "version": { "type": "string", "example": "1.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Стан застосунку і БД",
        "responses": {
          "200": {
            "description": "Застосунок і БД працюють",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          },
          "503": {
            "description": "БД недоступна",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "error" } }
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Отримати JWT-токен",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Токен (дійсний 1 годину)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "token": { "type": "string" } }
                }
              }
            }
          },
          "401": {
            "description": "Неправильний логін або пароль",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "Останні 50 задач, новіші першими",
        "responses": {
          "200": {
            "description": "Масив задач (не більше 50)",
            "headers": {
              "X-Cache": {
                "description": "HIT - відповідь з Redis, MISS - з бази і записано в кеш, BYPASS - кеш вимкнено або Redis недоступний",
                "schema": { "type": "string", "enum": ["HIT", "MISS", "BYPASS"] }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Створити задачу",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewTask" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Задачу створено",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": {
            "description": "Не передано title",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Немає або недійсний токен",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "minimum": 1 }
        }
      ],
      "get": {
        "summary": "Одна задача",
        "responses": {
          "200": {
            "description": "Задача",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": {
            "description": "Некоректний id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Задачу не знайдено",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Видалити задачу",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": {
            "description": "Задачу видалено"
          },
          "400": {
            "description": "Некоректний id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Немає або недійсний токен",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Задачу не знайдено",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/authors/{username}": {
      "parameters": [
        {
          "name": "username",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "example": "admin" }
        }
      ],
      "get": {
        "summary": "Дані автора: кількість задач і час останньої",
        "responses": {
          "200": {
            "description": "Дані автора (для автора без задач taskCount = 0, lastTaskAt = null)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Author" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "password": { "type": "string" }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Купити молоко" },
          "done": { "type": "boolean", "example": false },
          "created_at": { "type": "string", "format": "date-time" },
          "author": { "type": "string", "nullable": true, "example": "admin" }
        }
      },
      "NewTask": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "example": "Купити молоко" }
        }
      },
      "Author": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "example": "admin" },
          "taskCount": { "type": "integer", "example": 12 },
          "lastTaskAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Task not found" }
        }
      }
    }
  }
}
